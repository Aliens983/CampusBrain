# ============================================================
# Docker Profile Configuration
# ============================================================

spring:
  datasource:
    url: jdbc:mysql://kb-mysql:3306/knowledge_base?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowMultiQueries=true
    username: root
    password: CHANGE_ME
  mail:
    host: ${MAIL_HOST:smtp.163.com}
    port: ${MAIL_PORT:465}
    username: ${MAIL_USERNAME:}
    password: ${MAIL_PASSWORD:}
    protocol: smtp
    properties:
      mail:
        smtp:
          auth: true
          ssl:
            enable: true
            required: true
  data:
    redis:
      host: kb-redis
  rabbitmq:
    host: kb-rabbitmq
    username: admin
    password: CHANGE_ME

elasticsearch:
  host: kb-es
  port: 9200

qdrant:
  host: kb-qdrant
  port: 6334

minio:
  endpoint: http://kb-minio:9000
  access-key: CHANGE_ME
  secret-key: CHANGE_ME

# 生产环境关闭 mock 登录
app:
  security:
    mock-enable: false

logging:
  level:
    com.kb: INFO
