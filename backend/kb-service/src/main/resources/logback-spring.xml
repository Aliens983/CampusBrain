<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logback 日志配置
    - dev profile: 控制台彩色日志 + 文件日志（com.kb=DEBUG）
    - 未指定 profile/default：控制台彩色日志 + 文件日志（com.kb=INFO）
    - docker profile: 控制台纯文本（容器日志由 Docker/采集端统一收集，不再写容器内文件）
    - 自动注入 TraceId（MDC）用于链路追踪
    注：JSON 编码器（logstash-logback-encoder）未纳入依赖，docker profile
    不使用 LogstashEncoder，避免激活该 profile 时因类缺失导致日志系统初始化失败。
-->
<configuration>
    <!-- ========== 基础属性 ========== -->
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
    <property name="LOG_FILE" value="${LOG_FILE:-kb-server}"/>
    <property name="MAX_HISTORY" value="30"/>
    <property name="MAX_FILE_SIZE" value="50MB"/>
    <property name="TOTAL_SIZE_CAP" value="2GB"/>

    <!-- ========== Spring Profile: dev（本地开发，DEBUG） ========== -->
    <springProfile name="dev">
        <!-- 控制台彩色输出 -->
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) [%X{traceId:-}] %cyan(%logger{36}) - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <!-- 文件滚动输出 -->
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/${LOG_FILE}.log</file>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-}] %logger{36} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/archived/${LOG_FILE}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
                <maxHistory>${MAX_HISTORY}</maxHistory>
                <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
            </rollingPolicy>
        </appender>

        <!-- 慢查询日志（SQL > 200ms） -->
        <appender name="SLOW_SQL" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/slow-sql.log</file>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{traceId:-}] %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/archived/slow-sql-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>7</maxHistory>
            </rollingPolicy>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>

        <!-- 框架日志级别 -->
        <logger name="com.kb" level="DEBUG"/>
        <logger name="com.kb.infrastructure.persistence" level="INFO"/>
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.apache.tika" level="WARN"/>
    </springProfile>

    <!-- ========== Spring Profile: default（未显式指定 profile，INFO） ========== -->
    <springProfile name="default">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) [%X{traceId:-}] %cyan(%logger{36}) - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/${LOG_FILE}.log</file>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-}] %logger{36} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/archived/${LOG_FILE}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
                <maxHistory>${MAX_HISTORY}</maxHistory>
                <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
            </rollingPolicy>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>

        <!-- 生产/未指定 profile 默认 INFO，避免用户提问与检索片段进容器日志 -->
        <logger name="com.kb" level="INFO"/>
        <logger name="com.kb.infrastructure.persistence" level="INFO"/>
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.apache.tika" level="WARN"/>
    </springProfile>

    <!-- ========== Spring Profile: docker（容器运行，仅控制台纯文本） ========== -->
    <springProfile name="docker">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-}] %logger{36} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <logger name="com.kb" level="INFO"/>
        <logger name="com.kb.infrastructure.persistence" level="INFO"/>
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.apache.tika" level="WARN"/>
    </springProfile>

    <!-- ========== 日志级别覆盖 ========== -->
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.mybatis" level="WARN"/>
    <logger name="io.qdrant" level="WARN"/>
    <logger name="co.elastic" level="WARN"/>
</configuration>
