<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logback 日志配置
    - dev profile: 控制台彩色日志 + 文件日志
    - docker profile: JSON 格式（方便 ELK 采集）+ 文件日志
    - 自动注入 TraceId（MDC）用于链路追踪
-->
<configuration>
    <!-- ========== 基础属性 ========== -->
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
    <property name="LOG_FILE" value="${LOG_FILE:-kb-server}"/>
    <property name="MAX_HISTORY" value="30"/>
    <property name="MAX_FILE_SIZE" value="50MB"/>
    <property name="TOTAL_SIZE_CAP" value="2GB"/>

    <!-- ========== Spring Profile: dev（默认） ========== -->
    <springProfile name="dev,default">
        <!-- 控制台彩色输出 -->
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) [%X{traceId:-}] %cyan(%logger{36}) - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <!-- 文件滚动输出 -->
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/${LOG_FILE}.log</file>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-}] %logger{36} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/archived/${LOG_FILE}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
                <maxHistory>${MAX_HISTORY}</maxHistory>
                <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
            </rollingPolicy>
        </appender>

        <!-- 慢查询日志（SQL > 200ms） -->
        <appender name="SLOW_SQL" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/slow-sql.log</file>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{traceId:-}] %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/archived/slow-sql-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>7</maxHistory>
            </rollingPolicy>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>

        <!-- 框架日志级别 -->
        <logger name="com.kb" level="DEBUG"/>
        <logger name="com.kb.infrastructure.persistence" level="INFO"/>
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.apache.tika" level="WARN"/>
    </springProfile>

    <!-- ========== Spring Profile: docker ========== -->
    <springProfile name="docker">
        <!-- JSON 格式控制台日志（方便容器日志采集 → ELK） -->
        <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeContext>false</includeContext>
                <customFields>{"app":"kb-server"}</customFields>
                <fieldNames>
                    <timestamp>@timestamp</timestamp>
                    <message>message</message>
                </fieldNames>
            </encoder>
        </appender>

        <!-- 简单格式回退 -->
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-}] %logger{36} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ========== 日志级别覆盖 ========== -->
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.mybatis" level="WARN"/>
    <logger name="io.qdrant" level="WARN"/>
    <logger name="co.elastic" level="WARN"/>
</configuration>
