<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude generated Lombok code -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- Exclude MyBatis-Plus generated mapper proxies -->
    <Match>
        <Package name="com.kb.infrastructure.persistence.mysql"/>
        <Bug pattern="SQL_INJECTION_MYBATIS"/>
    </Match>
</FindBugsFilter>
