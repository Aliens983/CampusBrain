<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.laoliu.cas.appointment.infrastructure.persistence.mapper.ServiceItemMapper">

    <!-- 必须列全：findByUserId / selectUserServices 等走本 resultMap，
         此前只映射 4 列，导致"我的服务"返回的实体 campus / categoryId / capacity
         全为 null，前端拿不到校区与分类，容量判断也会失真。 -->
    <resultMap id="BaseResultMap" type="com.laoliu.cas.appointment.infrastructure.persistence.dataobject.ServiceItemDO">
        <id property="serviceId" column="service_id"/>
        <result property="serviceName" column="service_name"/>
        <result property="serviceDescribe" column="service_describe"/>
        <result property="serviceState" column="service_state"/>
        <result property="categoryId" column="category_id"/>
        <result property="campus" column="campus"/>
        <result property="capacity" column="capacity"/>
        <result property="bookedCount" column="booked_count"/>
        <result property="imageUrl" column="image_url"/>
        <result property="endDate" column="end_date"/>
    </resultMap>

    <sql id="Base_Column_List">
        service_id,service_name,service_describe,service_state,
        category_id,campus,capacity,booked_count,image_url,end_date
    </sql>

    <!-- 带表别名版本：JOIN 查询里 resultMap 按无前缀列名映射，必须用 AS 还原 -->
    <sql id="Base_Column_List_With_Alias">
        s.service_id AS service_id,
        s.service_name AS service_name,
        s.service_describe AS service_describe,
        s.service_state AS service_state,
        s.category_id AS category_id,
        s.campus AS campus,
        s.capacity AS capacity,
        s.booked_count AS booked_count,
        s.image_url AS image_url,
        s.end_date AS end_date
    </sql>

    <insert id="insertSelective" parameterType="com.laoliu.cas.appointment.infrastructure.persistence.dataobject.ServiceItemDO"
            useGeneratedKeys="true" keyProperty="serviceId">
        INSERT INTO services (service_name, service_describe, service_state)
        VALUES (#{serviceName}, #{serviceDescribe}, #{serviceState})
    </insert>

    <!-- 管理端更新服务：只写可编辑列，刻意不含 booked_count.
         booked_count 必须由 BookingRepository 的条件更新原子维护，
         随全量实体回写会与并发下单/取消形成丢失更新（名额账实不符甚至超卖）。
         category_id / campus 创建后不可变，亦不在本语句更新范围。
         调用方传入完整加载的实体，service_name / service_describe 必非空。 -->
    <update id="updateByPrimaryKeySelective" parameterType="com.laoliu.cas.appointment.infrastructure.persistence.dataobject.ServiceItemDO">
        UPDATE services
        <set>
            <if test="serviceName != null">
                service_name = #{serviceName},
            </if>
            <if test="serviceDescribe != null">
                service_describe = #{serviceDescribe},
            </if>
            <if test="serviceState != null">
                service_state = #{serviceState},
            </if>
            <if test="capacity != null">
                capacity = #{capacity},
            </if>
            <if test="imageUrl != null">
                image_url = #{imageUrl},
            </if>
            <if test="endDate != null">
                end_date = #{endDate},
            </if>
        </set>
        WHERE service_id = #{serviceId}
    </update>

    <select id="selectUserServices" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List_With_Alias"/>
        FROM item i
        JOIN services s ON i.service_id = s.service_id
        WHERE i.user_id = #{userId}
    </select>

    <select id="selectUserServicesWithPage" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List_With_Alias"/>
        FROM item i
        JOIN services s ON i.service_id = s.service_id
        WHERE i.user_id = #{userId}
        ORDER BY s.service_id DESC
    </select>

</mapper>
