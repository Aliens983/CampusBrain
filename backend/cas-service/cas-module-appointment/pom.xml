<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.laoliu</groupId>
        <artifactId>CampusAppointmentSystem</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>cas-module-appointment</artifactId>
    <packaging>jar</packaging>

    <name>cas-module-appointment</name>
    <description>Appointment Business Module - Service Booking, Item Management</description>

    <dependencies>
        <dependency>
            <groupId>com.laoliu</groupId>
            <artifactId>cas-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 2.3：跨模块只依赖 api 契约 artifact，编译期看不到 system/infra 内部实现 -->
        <dependency>
            <groupId>com.laoliu</groupId>
            <artifactId>cas-module-system-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.laoliu</groupId>
            <artifactId>cas-module-infra-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.laoliu</groupId>
            <artifactId>cas-spring-boot-starter-mybatis</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- RedisUtil 被 AppointmentAssistantServiceImpl 直接使用（2.3 收窄跨模块依赖后显式声明） -->
        <dependency>
            <groupId>com.laoliu</groupId>
            <artifactId>cas-spring-boot-starter-redis</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.laoliu</groupId>
            <artifactId>cas-spring-boot-starter-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- 业务指标埋点（5.2.2）：仅 API，registry 由 cas-server 的
             micrometer-registry-prometheus 在运行时提供 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- MapStruct -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
