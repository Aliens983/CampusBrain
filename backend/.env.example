# ============================================================
# 环境变量示例 — 复制为 .env 并填入真实值（.env 已 gitignore）
# 用法：cp .env.example .env && docker compose up -d
# ============================================================

# ---------- 数据库 ----------
# CAS 依赖的宿主机 MySQL 密码（必填，无默认值）
MYSQL_ROOT_PASSWORD=
# KB 专用 MySQL 密码（docker-compose 内部默认 root123，仅限本地开发）
KB_MYSQL_ROOT_PASSWORD=root123

# ---------- 认证密钥（生产必改）----------
# 下方为「本机开发专用」固定值，仅用于让 cp .env.example .env 后能直接跑起来。
# 生产/服务器部署必须替换为随机值：openssl rand -base64 48
# 代码侧的 ${JWT_SECRET} / ${INTERNAL_SIGN_SECRET} 已无默认值，未注入会启动失败。
JWT_SECRET=ZGV2LW9ubHktand0LXNlY3JldC1kb25vdC11c2UtaW4tcHJvZA==
INTERNAL_SIGN_SECRET=dev-only-internal-sign-secret
# 演示模式：true=每次启动先 flyway.clean() 清库再重建（仅在显式同时放开下方开关时生效）
APP_DB_RESET_ON_STARTUP=false
# true=禁用 flyway clean（默认，防误删生产库）；演示环境需显式置 false
FLYWAY_CLEAN_DISABLED=true

# ---------- RabbitMQ / MinIO（本地开发默认值，生产必改）----------
RABBITMQ_PASSWORD=admin123
# MinIO 根密码，同时用作访问密钥（secret-key）
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ACCESS_KEY=minioadmin

# ---------- 邮件（可选，不配则不发验证码邮件）----------
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- 第三方 API（可选）----------
WEATHER_API_ID=
WEATHER_API_KEY=
# DeepSeek key（预留：CAS 侧旧 Qwen /ai/chat 已下线，当前仅 application.yml 保留配置位）
DEEPSEEK_API_KEY=
# KB langchain4j openai.api-key（内容同上，DeepSeek 的 OpenAI 兼容接口）
OPENAI_API_KEY=
# 文本嵌入 key（硅基流动，KB embedding-model）
EMBEDDING_API_KEY=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
