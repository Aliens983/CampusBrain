# ============================================================
# 环境变量示例 — 复制为 .env 并填入真实值（.env 已 gitignore）
# 用法：cp .env.example .env && docker compose up -d
# ============================================================

# ---------- 数据库 ----------
# CAS 库 root 密码（cas-mysql 容器，宿主机映射 127.0.0.1:13306，库 cas_db）
MYSQL_ROOT_PASSWORD=
# KB 专用 MySQL 密码（kb-mysql 容器，宿主机映射 127.0.0.1:3307；docker-compose 内部默认 root123，仅限本地开发）
KB_MYSQL_ROOT_PASSWORD=root123

# ---------- 认证密钥（生产必改）----------
# 下方为「本机开发专用」固定值，仅用于让 cp .env.example .env 后能直接跑起来。
# 生产/服务器部署必须替换为随机值：openssl rand -base64 48
# 代码侧的 ${JWT_SECRET} / ${INTERNAL_SIGN_SECRET} 已无默认值，未注入会启动失败。
JWT_SECRET=ZGV2LW9ubHktand0LXNlY3JldC1kb25vdC11c2UtaW4tcHJvZA==
INTERNAL_SIGN_SECRET=dev-only-internal-sign-secret
# 演示模式：true=每次启动先 flyway.clean() 清库再重建（仅在显式同时放开下方开关时生效）
APP_DB_RESET_ON_STARTUP=false
# true=禁用 flyway clean（默认，防误删生产库）；演示环境需显式置 false
FLYWAY_CLEAN_DISABLED=true

# ---------- CORS（网关统一配置，4.1.8）----------
# 允许的前端来源，逗号分隔；生产环境替换为实际域名（含协议、端口）
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# ---------- RabbitMQ（本地开发默认值，生产必改）----------
RABBITMQ_PASSWORD=admin123

# ---------- 中间件访问控制（部署到非本机网络必须配置）----------
# 所有中间件端口已只绑 127.0.0.1，以下口令留空时本地开发不受影响；
# 服务器/多人网络部署时务必填写（建议 openssl rand -base64 24）。
# Redis（CAS/KB 两套独立实例）
CAS_REDIS_PASSWORD=
KB_REDIS_PASSWORD=
# Qdrant 向量库 API Key
QDRANT_API_KEY=
# Nacos 鉴权：置 true 后必须同时填写 token（Base64、≥32 字节）与 identity，
# 并把控制台账号填入 NACOS_USERNAME/NACOS_PASSWORD（默认控制台账号 nacos/nacos，登录后请改密）
NACOS_AUTH_ENABLE=false
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
NACOS_USERNAME=
NACOS_PASSWORD=

# ---------- 种子账号口令（仅首次部署）----------
# Flyway 播种的 11 个账号默认口令均为 123456（admin@/user@/9 名教师）。
# 首次部署在此设置新口令，服务首启时仅重置仍为默认口令的种子账号，随后清空本项。
SEED_ACCOUNT_PASSWORD=

# ---------- 邮件（可选，不配则不发验证码邮件）----------
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- 第三方 API（可选）----------
WEATHER_API_ID=
WEATHER_API_KEY=
# DeepSeek key（预留：CAS 侧旧 Qwen /ai/chat 已下线，当前仅 application.yml 保留配置位）
DEEPSEEK_API_KEY=
# KB langchain4j openai.api-key（内容同上，DeepSeek 的 OpenAI 兼容接口）
OPENAI_API_KEY=
# 文本嵌入 key（硅基流动，KB embedding-model）
EMBEDDING_API_KEY=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
